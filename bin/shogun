#!/usr/bin/env bash
# Shogun - ローカルAIオーケストレーションフレームワーク グローバルCLI
set -euo pipefail

# ─── パス解決 ──────────────────────────────────────────────
# シンボリックリンクを辿って実体のディレクトリ（bin/）を取得
_src="${BASH_SOURCE[0]}"
while [[ -L "${_src}" ]]; do
  _dir="$(cd -P "$(dirname "${_src}")" && pwd)"
  _src="$(readlink "${_src}")"
  [[ "${_src}" != /* ]] && _src="${_dir}/${_src}"
done
_SCRIPT_DIR="$(cd -P "$(dirname "${_src}")" && pwd)"
unset _src _dir
# リポジトリルート（bin/ の1階層上）
SHOGUN_BIN_DIR="$(cd "${_SCRIPT_DIR}/.." && pwd)"

# ─── .shogun/ 探索 ─────────────────────────────────────────
find_shogun_root() {
  local dir
  dir="$(pwd)"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "${dir}/.shogun" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

require_init() {
  if ! SHOGUN_ROOT="$(find_shogun_root)"; then
    echo "ERROR: .shogun/ が見つかりません。"
    echo "       このコマンドは shogun init を実行したプロジェクト内で使用してください。"
    exit 1
  fi
  export SHOGUN_ROOT
}

# ─── node / js-yaml ユーティリティ ────────────────────────
NODE_PATH_ARG="${SHOGUN_BIN_DIR}/node_modules"

node_yaml() {
  NODE_PATH="${NODE_PATH_ARG}" node "$@"
}

# ─── カラー出力 ────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { echo -e "${BLUE}[shogun]${RESET} $*"; }
success() { echo -e "${GREEN}[shogun]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[shogun]${RESET} $*"; }
error()   { echo -e "${RED}[shogun] ERROR:${RESET} $*" >&2; }

# config.yaml から ashigaru_count を取得（デフォルト 3）
read_ashigaru_count() {
  local config="$1"
  node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
process.stdout.write(String((d.agents && d.agents.ashigaru_count) || 3));
' -- "$config"
}

# ashigaru1〜N のエージェント名配列を生成
ashigaru_agents() {
  local count="$1"
  local -a list=(taisho karo gunshi metsuke)
  for ((i=1; i<=count; i++)); do list+=("ashigaru${i}"); done
  echo "${list[@]}"
}

# config.yaml から project_name を取得（デフォルト shogun）
read_project_name() {
  local config="$1"
  node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
process.stdout.write(String(d.project_name || "shogun"));
' -- "$config"
}

# project_name を tmux セッション名に使える safe_name に変換
project_safe_name() {
  local project_name="$1"
  local safe_name
  safe_name="$(printf "%s" "$project_name" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_')"
  if [[ -z "$safe_name" ]]; then
    safe_name="shogun"
  fi
  printf "%s" "$safe_name"
}

# SHOGUN_ROOT のシンボリックリンクを解決して物理パスを返す
project_physical_root() {
  local root="$1"
  (cd "$root" && pwd -P) || { error "ディレクトリを解決できません: $root"; return 1; }
}

# 物理パスからセッション名衝突防止用の短縮 hash を生成
project_root_hash() {
  local root="$1"
  local physical_root
  physical_root="$(project_physical_root "$root")"
  node_yaml -e '
const crypto = require("crypto");
process.stdout.write(crypto.createHash("sha1").update(process.argv[1]).digest("hex").slice(0, 8));
' -- "$physical_root"
}

# project_name と SHOGUN_ROOT から Shogun が管理する tmux セッション名を生成
project_session_names() {
  local project_name="$1"
  local project_root="$2"
  local safe_name root_hash
  safe_name="$(project_safe_name "$project_name")" || return 1
  root_hash="$(project_root_hash "$project_root")"
  printf "%s %s\n" "taisho-${safe_name}-${root_hash}" "multiagent-${safe_name}-${root_hash}"
}

# hash 導入前の legacy tmux セッション名を生成（既存の cmd_start と同じスペースのみ置換）
legacy_project_session_names() {
  local project_name="$1"
  local safe_name="${project_name// /_}"
  printf "%s %s\n" "taisho-${safe_name}" "multiagent-${safe_name}"
}

# tmux の曖昧マッチを避ける exact target を生成
tmux_exact_target() {
  printf "=%s" "$1"
}

# ════════════════════════════════════════════════════════════
# shogun init
# ════════════════════════════════════════════════════════════
cmd_init() {
  local project_dir
  project_dir="$(pwd)"
  local shogun_dir="${project_dir}/.shogun"

  if [[ -d "$shogun_dir" ]]; then
    info ".shogun/ はすでに存在します（初期化済み）。"
    exit 0
  fi

  info "Shogun を初期化中: ${project_dir}"

  local templates="${SHOGUN_BIN_DIR}/templates"

  # ディレクトリ構造を作成
  mkdir -p \
    "${shogun_dir}/queue/tasks" \
    "${shogun_dir}/queue/reports" \
    "${shogun_dir}/queue/inbox" \
    "${shogun_dir}/instructions" \
    "${shogun_dir}/memory" \
    "${shogun_dir}/logs"

  # templates/config/settings.yaml → .shogun/config.yaml
  cp "${templates}/config/settings.yaml" "${shogun_dir}/config.yaml"

  # templates/CLAUDE.md → .shogun/CLAUDE.md
  cp "${templates}/CLAUDE.md" "${shogun_dir}/CLAUDE.md"

  # templates/instructions/*.md → .shogun/instructions/
  cp "${templates}/instructions/"*.md "${shogun_dir}/instructions/"

  # templates/memory/MEMORY.md.sample → .shogun/memory/MEMORY.md.sample
  cp "${templates}/memory/MEMORY.md.sample" "${shogun_dir}/memory/MEMORY.md.sample"

  # config.yaml の先頭に project_name を追加
  local project_name
  project_name="$(basename "$project_dir")"
  local tmp_config
  tmp_config="$(mktemp)"
  {
    echo "project_name: ${project_name}"
    cat "${shogun_dir}/config.yaml"
  } > "$tmp_config"
  mv "$tmp_config" "${shogun_dir}/config.yaml"

  # templates/dashboard.md → .shogun/dashboard.md（project_name を埋め込む）
  sed "s/{{project_name}}/${project_name}/g" \
    "${templates}/dashboard.md" > "${shogun_dir}/dashboard.md"

  # queue/shogun_to_karo.yaml を初期化
  echo "commands: []" > "${shogun_dir}/queue/shogun_to_karo.yaml"

  # config.yaml の ashigaru_count に基づいてエージェントファイルを初期化
  local init_count
  init_count="$(read_ashigaru_count "${shogun_dir}/config.yaml")"
  local agents
  read -ra agents <<< "$(ashigaru_agents "$init_count")"
  for agent in "${agents[@]}"; do
    echo "messages: []"   > "${shogun_dir}/queue/inbox/${agent}.yaml"
    echo "tasks: []"      > "${shogun_dir}/queue/tasks/${agent}.yaml"
    echo "reports: []"    > "${shogun_dir}/queue/reports/${agent}_report.yaml"
  done

  # .gitignore に追記
  local gitignore="${project_dir}/.gitignore"
  local append_src="${templates}/.gitignore.append"
  if [[ -f "$gitignore" ]]; then
    info ".gitignore に Shogun エントリを追記します。"
    {
      echo ""
      echo "# --- Shogun ---"
      cat "$append_src"
    } >> "$gitignore"
  else
    info ".gitignore が存在しないためスキップしました（手動で追加してください）。"
  fi

  success "初期化完了! プロジェクト: ${project_name}"
  echo ""
  echo -e "  ${BOLD}次のステップ:${RESET}"
  echo -e "  1. ${CYAN}shogun doctor${RESET}          依存ツールを確認"
  echo -e "  2. ${CYAN}shogun start${RESET}           エージェントを起動"
  echo -e "  3. ${CYAN}shogun task \"やること\"${RESET}  タスクを投入"
}

# ════════════════════════════════════════════════════════════
# shogun task "<説明>" [--priority high]
# ════════════════════════════════════════════════════════════
cmd_task() {
  require_init

  local task_desc=""
  local priority="normal"

  # 引数パース
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --priority)
        priority="${2:?--priority には値が必要です}"
        shift 2
        ;;
      --priority=*)
        priority="${1#--priority=}"
        shift
        ;;
      -*)
        error "不明なオプション: $1"
        exit 1
        ;;
      *)
        task_desc="$1"
        shift
        ;;
    esac
  done

  # タスク説明が空なら対話入力
  if [[ -z "$task_desc" ]]; then
    echo -n "タスクの説明を入力してください: "
    read -r task_desc
    if [[ -z "$task_desc" ]]; then
      error "タスクの説明が空です。"
      exit 1
    fi
  fi

  local queue_file="${SHOGUN_ROOT}/.shogun/queue/shogun_to_karo.yaml"
  local timestamp
  timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  # ID 生成（既存コマンド数+1、ゼロパディング3桁）
  local cmd_id
  cmd_id=$(node_yaml -e '
const fs = require("fs");
const yaml = require("js-yaml");
const queueFile = process.argv[1];
const data = yaml.load(fs.readFileSync(queueFile, "utf8")) || {commands: []};
const cmds = data.commands || [];
const next = cmds.length + 1;
process.stdout.write("cmd_" + String(next).padStart(3, "0"));
' -- "$queue_file")

  # shogun_to_karo.yaml にコマンドを追記
  node_yaml -e '
const fs = require("fs");
const yaml = require("js-yaml");
const [queueFile, id, ts, command, priority] = process.argv.slice(1);
const data = yaml.load(fs.readFileSync(queueFile, "utf8")) || {commands: []};
data.commands = data.commands || [];
data.commands.push({
  id,
  timestamp: ts,
  command,
  priority,
  status: "pending"
});
fs.writeFileSync(queueFile, yaml.dump(data, {allowUnicode: true}));
' -- "$queue_file" "$cmd_id" "$timestamp" "$task_desc" "$priority"

  success "タスクを追加しました: ${cmd_id}"
  info "説明: ${task_desc}"
  info "優先度: ${priority}"

  # inbox_write.sh 経由で taisho に通知
  SHOGUN_ROOT="${SHOGUN_ROOT}" SHOGUN_ROLE=shogun \
    bash "${SHOGUN_BIN_DIR}/scripts/inbox_write.sh" \
    taisho \
    "新規タスク: ${cmd_id}" \
    "${task_desc}"
}

# ════════════════════════════════════════════════════════════
# shogun start [--clean] [--setup] [--count N] [--legacy-cleanup]
# ════════════════════════════════════════════════════════════
cmd_start() {
  require_init

  local do_clean=false
  local setup_only=false
  local count_override=""
  local legacy_cleanup=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clean)   do_clean=true; shift ;;
      --setup)   setup_only=true; shift ;;
      --legacy-cleanup) legacy_cleanup=true; shift ;;
      --count)
        count_override="${2:?--count には値が必要です}"
        shift 2
        ;;
      --count=*)
        count_override="${1#--count=}"
        shift
        ;;
      *)
        error "不明なオプション: $1"
        exit 1
        ;;
    esac
  done

  local config_file="${SHOGUN_ROOT}/.shogun/config.yaml"

  # config.yaml から設定読み込み
  local project_name ashigaru_count worker_model taisho_model skip_permissions
  project_name="$(read_project_name "$config_file")"

  ashigaru_count=$(node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
process.stdout.write(String((d.agents && d.agents.ashigaru_count) || 3));
' -- "$config_file")

  worker_model=$(node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
process.stdout.write(String((d.agents && d.agents.worker_model) || "sonnet"));
' -- "$config_file")

  taisho_model=$(node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
process.stdout.write(String((d.agents && d.agents.taisho_model) || "opus"));
' -- "$config_file")

  skip_permissions=$(node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {};
const v = (d.startup && d.startup.skip_permissions) === true;
process.stdout.write(v ? "true" : "false");
' -- "$config_file")

  # --count オプションで上書き
  if [[ -n "$count_override" ]]; then
    ashigaru_count="$count_override"
  fi

  # セッション名
  local session_taisho session_multi
  read -r session_taisho session_multi <<< "$(project_session_names "$project_name" "$SHOGUN_ROOT")" || exit 1

  info "プロジェクト: ${project_name}"
  info "足軽数: ${ashigaru_count}"
  info "Taisho モデル: ${taisho_model} / Worker モデル: ${worker_model}"

  # --clean: バックアップ & キューリセット
  if [[ "$do_clean" == "true" ]]; then
    local backup_dir
    backup_dir="${SHOGUN_ROOT}/.shogun/logs/backup_$(date +%Y%m%d_%H%M%S)"
    info "--clean: キューを ${backup_dir} にバックアップ"
    mkdir -p "$backup_dir"
    cp -r "${SHOGUN_ROOT}/.shogun/queue/." "${backup_dir}/"

    # キューリセット（ashigaru_count は cmd_start 冒頭で読み込み済み）
    echo "commands: []" > "${SHOGUN_ROOT}/.shogun/queue/shogun_to_karo.yaml"
    local clean_agents
    read -ra clean_agents <<< "$(ashigaru_agents "$ashigaru_count")"
    for agent in "${clean_agents[@]}"; do
      echo "messages: []" > "${SHOGUN_ROOT}/.shogun/queue/inbox/${agent}.yaml"
      echo "tasks: []"    > "${SHOGUN_ROOT}/.shogun/queue/tasks/${agent}.yaml"
      echo "reports: []"  > "${SHOGUN_ROOT}/.shogun/queue/reports/${agent}_report.yaml"
    done
    success "キューをリセットしました。"
  fi

  # 既存セッションを終了
  tmux kill-session -t "$(tmux_exact_target "$session_taisho")" 2>/dev/null && info "既存セッション ${session_taisho} を終了" || true
  tmux kill-session -t "$(tmux_exact_target "$session_multi")"  2>/dev/null && info "既存セッション ${session_multi} を終了"  || true

  if [[ "$legacy_cleanup" == "true" ]]; then
    local legacy_session_taisho legacy_session_multi
    read -r legacy_session_taisho legacy_session_multi <<< "$(legacy_project_session_names "$project_name")" || exit 1
    tmux kill-session -t "$(tmux_exact_target "$legacy_session_taisho")" 2>/dev/null && info "既存セッション ${legacy_session_taisho} を終了" || true
    tmux kill-session -t "$(tmux_exact_target "$legacy_session_multi")"  2>/dev/null && info "既存セッション ${legacy_session_multi} を終了"  || true
  fi

  # claude コマンドのオプション
  # .shogun/config.yaml で startup.skip_permissions: true を明示した場合のみ付与
  local claude_opts=""
  if [[ "$skip_permissions" == "true" ]]; then
    claude_opts="--dangerously-skip-permissions"
  fi

  # ─── taisho-<safe_name>-<hash> セッション（Taisho 用、1ペイン）
  tmux new-session -d -s "$session_taisho" -x 220 -y 50
  tmux set-option -t "$session_taisho" status-style "bg=magenta,fg=white"

  # inbox_watcher.sh をバックグラウンドで起動（Taisho）
  # claude より先に起動しないと、claude の TUI が入力を乗っ取り
  # inbox_watcher のコマンド文字列が Claude の入力欄に入ってしまう
  local taisho_pane
  taisho_pane="${session_taisho}:0"
  # SHOGUN_WATCH_REPORTS=1: Taisho は reports/ も監視し、Karo の報告書き込み漏れに備える
  tmux send-keys -t "$taisho_pane" \
    "SHOGUN_ROOT=${SHOGUN_ROOT} SHOGUN_WATCH_REPORTS=1 bash ${SHOGUN_BIN_DIR}/scripts/inbox_watcher.sh taisho ${taisho_pane} &" \
    Enter 2>/dev/null || true

  if [[ "$setup_only" == "false" ]]; then
    local taisho_cmd
    taisho_cmd="cd ${SHOGUN_ROOT} && SHOGUN_ROLE=taisho SHOGUN_ROOT=${SHOGUN_ROOT} SHOGUN_BIN_DIR=${SHOGUN_BIN_DIR} claude --model ${taisho_model} ${claude_opts} --add-dir ${SHOGUN_ROOT}/.shogun"
    tmux send-keys -t "${session_taisho}:0" "$taisho_cmd" Enter
  fi

  # ─── multiagent-<name> セッション
  # ペイン0: karo
  tmux new-session -d -s "$session_multi" -x 220 -y 50

  local pane_roles=("karo" "gunshi" "metsuke")
  # ashigaru1〜N を追加
  for ((i=1; i<=ashigaru_count; i++)); do
    pane_roles+=("ashigaru${i}")
  done

  local total_panes=${#pane_roles[@]}

  # 必要な分だけペインを追加作成（最初の1枚は new-session 時に作成済み）
  for ((i=1; i<total_panes; i++)); do
    tmux split-window -t "${session_multi}" -h 2>/dev/null || \
    tmux split-window -t "${session_multi}" -v 2>/dev/null || true
    tmux select-layout -t "${session_multi}" tiled 2>/dev/null || true
  done
  tmux select-layout -t "${session_multi}" tiled 2>/dev/null || true

  # 各ペインに inbox_watcher & claude を起動
  for ((i=0; i<total_panes; i++)); do
    local role="${pane_roles[$i]}"
    local pane_id="${session_multi}:0.${i}"

    # inbox_watcher を claude より先に起動する
    # claude の TUI が入力を乗っ取る前にバックグラウンドへ回す
    # Karo は reports/ も監視し、Ashigaru/Gunshi/Metsuke の報告書き込み漏れに備える
    local watch_reports_env=""
    [[ "$role" == "karo" ]] && watch_reports_env="SHOGUN_WATCH_REPORTS=1 "
    tmux send-keys -t "$pane_id" \
      "SHOGUN_ROOT=${SHOGUN_ROOT} ${watch_reports_env}bash ${SHOGUN_BIN_DIR}/scripts/inbox_watcher.sh ${role} ${pane_id} &" \
      Enter 2>/dev/null || true

    if [[ "$setup_only" == "false" ]]; then
      # ペインのモデルを決定
      local model="$worker_model"
      local role_cmd
      role_cmd="cd ${SHOGUN_ROOT} && SHOGUN_ROLE=${role} SHOGUN_ROOT=${SHOGUN_ROOT} SHOGUN_BIN_DIR=${SHOGUN_BIN_DIR} claude --model ${model} ${claude_opts} --add-dir ${SHOGUN_ROOT}/.shogun"
      tmux send-keys -t "$pane_id" "$role_cmd" Enter
    fi
  done

  echo ""
  success "Shogun 起動完了!"
  echo ""
  echo -e "  ${BOLD}セッションに接続:${RESET}"
  echo -e "  ${CYAN}tmux attach -t ${session_taisho}${RESET}   (Taisho)"
  echo -e "  ${CYAN}tmux attach -t ${session_multi}${RESET}   (マルチエージェント)"
  echo ""
  echo -e "  ${BOLD}タスク投入:${RESET}"
  echo -e "  ${CYAN}shogun task \"やること\"${RESET}"
}

# ════════════════════════════════════════════════════════════
# shogun stop
# ════════════════════════════════════════════════════════════
cmd_stop() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: shogun stop [--legacy]"
    echo "  --legacy    hash 導入前の legacy tmux セッション名も停止する"
    return 0
  fi

  require_init

  local include_legacy=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --legacy)
        include_legacy=1
        shift
        ;;
      *)
        error "不明なオプション: $1"
        echo "Usage: shogun stop [--legacy]"
        exit 1
        ;;
    esac
  done

  local config_file="${SHOGUN_ROOT}/.shogun/config.yaml"
  local project_name
  project_name="$(read_project_name "$config_file")"

  local session_taisho session_multi
  read -r session_taisho session_multi <<< "$(project_session_names "$project_name" "$SHOGUN_ROOT")" || exit 1
  local sessions=("$session_taisho" "$session_multi")

  if [[ "$include_legacy" -eq 1 ]]; then
    local legacy_session_taisho legacy_session_multi
    read -r legacy_session_taisho legacy_session_multi <<< "$(legacy_project_session_names "$project_name")" || exit 1
    sessions+=("$legacy_session_taisho" "$legacy_session_multi")
  fi

  local stopped=0
  local session

  info "プロジェクト: ${project_name}"
  if [[ "$include_legacy" -eq 1 ]]; then
    info "legacy セッションも停止対象に含めます。"
  fi

  for session in "${sessions[@]}"; do
    if tmux kill-session -t "$(tmux_exact_target "$session")" 2>/dev/null; then
      info "セッション ${session} を終了しました。"
      stopped=1
    else
      info "セッション ${session} は停止済みです。"
    fi
  done

  if [[ "$stopped" -eq 1 ]]; then
    success "Shogun を停止しました。"
  else
    success "Shogun はすでに停止しています。"
  fi
}

# ════════════════════════════════════════════════════════════
# shogun status
# ════════════════════════════════════════════════════════════
cmd_status() {
  require_init

  local config_file="${SHOGUN_ROOT}/.shogun/config.yaml"
  local project_name
  project_name="$(read_project_name "$config_file")"

  local session_taisho session_multi
  read -r session_taisho session_multi <<< "$(project_session_names "$project_name" "$SHOGUN_ROOT")" || exit 1

  echo -e "${BOLD}${MAGENTA}=== Shogun Status: ${project_name} ===${RESET}"
  echo ""

  # shogun_to_karo.yaml のコマンド一覧
  echo -e "${BOLD}[ コマンドキュー (shogun → karo) ]${RESET}"
  local queue_file="${SHOGUN_ROOT}/.shogun/queue/shogun_to_karo.yaml"
  if [[ -f "$queue_file" ]]; then
    node_yaml -e '
const yaml = require("js-yaml");
const data = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {commands: []};
const cmds = data.commands || [];
if (cmds.length === 0) {
  console.log("  (コマンドなし)");
} else {
  cmds.forEach(c => {
    const cmd60 = (c.command || "").slice(0, 60);
    const status = c.status || "unknown";
    const statusColor = status === "done" ? "\x1b[32m" : status === "pending" ? "\x1b[33m" : "\x1b[36m";
    console.log("  " + c.id + "  " + statusColor + "[" + status + "]\x1b[0m  " + cmd60);
  });
}
' -- "$queue_file"
  else
    echo "  (ファイルなし)"
  fi
  echo ""

  # 各エージェントのタスク状態
  echo -e "${BOLD}[ エージェント タスク状態 ]${RESET}"
  local status_count
  status_count="$(read_ashigaru_count "${SHOGUN_ROOT}/.shogun/config.yaml")"
  local agents
  read -ra agents <<< "$(ashigaru_agents "$status_count")"
  for agent in "${agents[@]}"; do
    local task_file="${SHOGUN_ROOT}/.shogun/queue/tasks/${agent}.yaml"
    local count="0"
    if [[ -f "$task_file" ]]; then
      count=$(node_yaml -e '
const yaml = require("js-yaml");
const d = yaml.load(require("fs").readFileSync(process.argv[1], "utf8")) || {tasks: []};
process.stdout.write(String((d.tasks || []).length));
' -- "$task_file" 2>/dev/null || echo "0")
    fi
    printf "  %-14s tasks: %s\n" "$agent" "$count"
  done
  echo ""

  # tmux セッション稼働確認
  echo -e "${BOLD}[ tmux セッション ]${RESET}"

  if tmux has-session -t "$(tmux_exact_target "$session_taisho")" 2>/dev/null; then
    echo -e "  ${GREEN}●${RESET} ${session_taisho} (稼働中)"
  else
    echo -e "  ${RED}○${RESET} ${session_taisho} (停止)"
  fi

  if tmux has-session -t "$(tmux_exact_target "$session_multi")" 2>/dev/null; then
    echo -e "  ${GREEN}●${RESET} ${session_multi} (稼働中)"
  else
    echo -e "  ${RED}○${RESET} ${session_multi} (停止)"
  fi

  # dashboard
  local dashboard="${SHOGUN_ROOT}/.shogun/dashboard.md"
  echo ""
  echo -e "${BOLD}[ dashboard ]${RESET}"
  if [[ -f "$dashboard" ]]; then
    echo -e "  ${dashboard}"
  else
    echo -e "  (dashboard.md が見つかりません。shogun init を再実行してください)"
  fi
}

# ════════════════════════════════════════════════════════════
# shogun logs [--agent <name>] [--tail N]
# ════════════════════════════════════════════════════════════
cmd_logs() {
  require_init

  local agent_filter=""
  local tail_n=50

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        agent_filter="${2:?--agent には値が必要です}"
        shift 2
        ;;
      --agent=*)
        agent_filter="${1#--agent=}"
        shift
        ;;
      --tail)
        tail_n="${2:?--tail には値が必要です}"
        shift 2
        ;;
      --tail=*)
        tail_n="${1#--tail=}"
        shift
        ;;
      *)
        error "不明なオプション: $1"
        exit 1
        ;;
    esac
  done

  local logs_dir="${SHOGUN_ROOT}/.shogun/logs"

  if [[ -n "$agent_filter" ]]; then
    local log_file="${logs_dir}/${agent_filter}.log"
    if [[ -f "$log_file" ]]; then
      info "ログ: ${log_file} (最新 ${tail_n} 行)"
      tail -n "$tail_n" "$log_file"
    else
      warn "ログファイルが見つかりません: ${log_file}"
    fi
  else
    local log_files=()
    while IFS= read -r -d '' f; do
      log_files+=("$f")
    done < <(find "$logs_dir" -maxdepth 1 -name "*.log" -print0 2>/dev/null)

    if [[ ${#log_files[@]} -eq 0 ]]; then
      info "ログファイルがありません: ${logs_dir}"
    else
      for f in "${log_files[@]}"; do
        echo -e "${BOLD}=== $(basename "$f") ===${RESET}"
        tail -n "$tail_n" "$f"
        echo ""
      done
    fi
  fi
}

# ════════════════════════════════════════════════════════════
# shogun doctor
# ════════════════════════════════════════════════════════════
cmd_doctor() {
  echo -e "${BOLD}${MAGENTA}=== Shogun Doctor ===${RESET}"
  echo ""
  local ok=true

  check_cmd() {
    local cmd="$1"
    local note="${2:-}"
    if command -v "$cmd" &>/dev/null; then
      echo -e "  ${GREEN}✓${RESET} ${cmd}$([ -n "$note" ] && echo " (${note})" || true)"
    else
      echo -e "  ${RED}✗${RESET} ${cmd} が見つかりません$([ -n "$note" ] && echo " → ${note}" || true)"
      ok=false
    fi
  }

  echo -e "${BOLD}[ 依存ツール ]${RESET}"
  check_cmd tmux   "tmuxのインストール: brew install tmux"
  check_cmd claude "Claude Code CLI"
  check_cmd node   "Node.js"
  if command -v flock &>/dev/null || [[ -x "/opt/homebrew/opt/util-linux/bin/flock" ]]; then
    echo -e "  ${GREEN}✓${RESET} flock"
  else
    echo -e "  ${RED}✗${RESET} flock が見つかりません → brew install util-linux"
    ok=false
  fi

  # js-yaml
  if NODE_PATH="${NODE_PATH_ARG}" node -e "require('js-yaml')" 2>/dev/null; then
    echo -e "  ${GREEN}✓${RESET} js-yaml (${SHOGUN_BIN_DIR}/node_modules)"
  else
    echo -e "  ${RED}✗${RESET} js-yaml が見つかりません → cd ${SHOGUN_BIN_DIR} && npm install"
    ok=false
  fi

  # fswatch or inotifywait
  if command -v fswatch &>/dev/null; then
    echo -e "  ${GREEN}✓${RESET} fswatch"
  elif command -v inotifywait &>/dev/null; then
    echo -e "  ${GREEN}✓${RESET} inotifywait"
  else
    echo -e "  ${YELLOW}!${RESET} fswatch / inotifywait が見つかりません"
    echo -e "       macOS: brew install fswatch"
    echo -e "       Linux: sudo apt install inotify-tools"
    ok=false
  fi

  echo ""
  echo -e "${BOLD}[ .shogun/ ]${RESET}"
  if SHOGUN_ROOT="$(find_shogun_root 2>/dev/null)"; then
    echo -e "  ${GREEN}✓${RESET} .shogun/ 発見: ${SHOGUN_ROOT}/.shogun"
  else
    echo -e "  ${YELLOW}!${RESET} .shogun/ が見つかりません（shogun init を実行してください）"
  fi

  echo ""
  echo -e "${BOLD}[ tmux セッション ]${RESET}"
  if SHOGUN_ROOT="$(find_shogun_root 2>/dev/null)"; then
    local config_file="${SHOGUN_ROOT}/.shogun/config.yaml"
    if [[ -f "$config_file" ]]; then
      local project_name
      project_name="$(read_project_name "$config_file" 2>/dev/null || echo "shogun")"
      local s1 s2
      read -r s1 s2 <<< "$(project_session_names "$project_name" "$SHOGUN_ROOT")"
      if tmux has-session -t "$(tmux_exact_target "$s1")" 2>/dev/null; then
        echo -e "  ${GREEN}●${RESET} ${s1} (稼働中)"
      else
        echo -e "  ${RED}○${RESET} ${s1} (停止)"
      fi
      if tmux has-session -t "$(tmux_exact_target "$s2")" 2>/dev/null; then
        echo -e "  ${GREEN}●${RESET} ${s2} (稼働中)"
      else
        echo -e "  ${RED}○${RESET} ${s2} (停止)"
      fi
    fi
  else
    echo -e "  ${YELLOW}!${RESET} プロジェクトが初期化されていないためスキップ"
  fi

  echo ""
  echo -e "${BOLD}[ Memory MCP ]${RESET}"
  if claude mcp list 2>/dev/null | grep -q memory; then
    echo -e "  ${GREEN}✓${RESET} memory MCP が設定されています"
  else
    echo -e "  ${YELLOW}!${RESET} memory MCP が見つかりません（任意）"
  fi

  echo ""
  if [[ "$ok" == "true" ]]; then
    success "すべてのチェックが通過しました。"
  else
    warn "一部のチェックが失敗しました。上記を確認してください。"
    exit 1
  fi
}

# ════════════════════════════════════════════════════════════
# shogun upgrade
# ════════════════════════════════════════════════════════════
_semver_lt() {
  local a="${1#v}" b="${2#v}"
  [[ "$a" == "$b" ]] && return 1
  local IFS=.
  local va=($a) vb=($b)
  for i in 0 1 2; do
    local na="${va[$i]:-0}" nb="${vb[$i]:-0}"
    (( na < nb )) && return 0
    (( na > nb )) && return 1
  done
  return 1
}

cmd_upgrade() {
  local target_version=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        [[ "${2:-}" ]] || { error "--version には値が必要です（例: shogun upgrade --version v0.0.2）"; exit 1; }
        target_version="$2"; shift 2 ;;
      --version=*)
        target_version="${1#--version=}"
        [[ -n "${target_version}" ]] || { error "--version には値が必要です（例: shogun upgrade --version v0.0.2）"; exit 1; }
        shift ;;
      *)           error "不明なオプション: $1"; exit 1 ;;
    esac
  done

  info "Shogun をアップデートします: ${SHOGUN_BIN_DIR}"

  if [[ -z "${target_version}" ]]; then
    info "GitHub API から最新バージョンを取得中..."
    local api_response
    local curl_args=(-fsSL --max-time 30 --connect-timeout 10 -H "Accept: application/vnd.github+json")
    [[ -n "${GITHUB_TOKEN:-}" ]] && curl_args+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
    api_response="$(curl "${curl_args[@]}" \
      "https://api.github.com/repos/dashi296/shogun/releases/latest" 2>/dev/null)" || {
      error "GitHub API へのアクセスに失敗しました。shogun upgrade --version v0.0.2 で明示してください。"
      exit 1
    }
    if command -v jq &>/dev/null; then
      target_version="$(echo "${api_response}" | jq -r '.tag_name // empty')"
    elif command -v python3 &>/dev/null; then
      target_version="$(echo "${api_response}" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tag_name',''))")"
    else
      target_version="$(echo "${api_response}" | grep '"tag_name"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/')"
    fi
    [[ -z "${target_version}" ]] && { error "バージョン情報を取得できませんでした。"; exit 1; }
  fi

  # タグ名のバリデーション（v1.2.3 形式のみ許可）
  [[ "${target_version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    error "不正なバージョン形式: ${target_version}（例: v0.0.2）"
    exit 1
  }

  local current_tag current_ref
  current_tag="$(git -C "${SHOGUN_BIN_DIR}" describe --tags --exact-match HEAD 2>/dev/null || echo "不明")"
  current_ref="$(git -C "${SHOGUN_BIN_DIR}" rev-parse HEAD 2>/dev/null || echo "")"
  [[ "${current_tag}" == "${target_version}" ]] && { success "すでに ${target_version} です。"; return 0; }
  if [[ "${current_tag}" != "不明" ]] && _semver_lt "${target_version}" "${current_tag}"; then
    warn "指定バージョン ${target_version} は現在の ${current_tag} より古いです。ダウングレードします。"
  fi

  # shallow clone なら unshallow してから全タグを取得
  if git -C "${SHOGUN_BIN_DIR}" rev-parse --is-shallow-repository 2>/dev/null | grep -q true; then
    git -C "${SHOGUN_BIN_DIR}" fetch --unshallow --quiet || true
  fi
  git -C "${SHOGUN_BIN_DIR}" fetch --tags --quiet

  if git -C "${SHOGUN_BIN_DIR}" checkout "${target_version}" --quiet; then
    if ! (cd "${SHOGUN_BIN_DIR}" && npm install --omit=dev); then
      error "npm install に失敗しました。Node.js のバージョンを確認してください（v18 以上推奨）。"
      if [[ -n "${current_ref}" ]]; then
        local rollback_target
        rollback_target="${current_tag}"
        [[ "${current_tag}" == "不明" ]] && rollback_target="${current_ref}"
        warn "${rollback_target} にロールバックします..."
        git -C "${SHOGUN_BIN_DIR}" checkout "${rollback_target}" --quiet || true
      fi
      exit 1
    fi
    success "Shogun を ${target_version} にアップデートしました。"
    info "注意: リポジトリは detached HEAD 状態です（タグ ${target_version} を指しています）。"
  else
    error "バージョン ${target_version} が見つかりません。"; exit 1
  fi
}

# ════════════════════════════════════════════════════════════
# shogun version
# ════════════════════════════════════════════════════════════
cmd_version() {
  local version
  version="$(git -C "${SHOGUN_BIN_DIR}" describe --tags --exact-match HEAD 2>/dev/null || true)"
  if [[ -z "${version}" ]]; then
    version="$(grep '"version"' "${SHOGUN_BIN_DIR}/package.json" | sed 's/.*"version": *"\([^"]*\)".*/\1/')"
    version="v${version} (dev)"
  fi
  echo "shogun ${version}"
}

# ════════════════════════════════════════════════════════════
# shogun help
# ════════════════════════════════════════════════════════════
cmd_help() {
  echo -e "${BOLD}${MAGENTA}Shogun${RESET} - ローカルAIオーケストレーションフレームワーク"
  echo ""
  echo -e "${BOLD}使い方:${RESET}"
  echo -e "  shogun <コマンド> [オプション]"
  echo ""
  echo -e "${BOLD}コマンド一覧:${RESET}"
  echo -e "  ${CYAN}init${RESET}                         プロジェクトを初期化 (.shogun/ を作成)"
  echo -e "  ${CYAN}start [--clean] [--setup] [--count N] [--legacy-cleanup]${RESET}"
  echo -e "                                エージェントを tmux で起動"
  echo -e "  ${CYAN}stop [--legacy]${RESET}               エージェントの tmux セッションを終了"
  echo -e "  ${CYAN}task${RESET} \"<説明>\" [--priority P]  新規タスクを投入"
  echo -e "  ${CYAN}status${RESET}                       現在の状態を表示"
  echo -e "  ${CYAN}logs${RESET} [--agent <名前>]         ログを表示"
  echo -e "       [--tail N]              最新 N 行を表示 (デフォルト: 50)"
  echo -e "  ${CYAN}doctor${RESET}                       依存ツールの確認"
  echo -e "  ${CYAN}upgrade${RESET}                      フレームワークをアップデート"
  echo -e "  ${CYAN}version${RESET}                      バージョンを表示"
  echo -e "  ${CYAN}help${RESET}                         このヘルプを表示"
  echo ""
  echo -e "${BOLD}クイックスタート:${RESET}"
  echo -e "  cd /path/to/your/project"
  echo -e "  ${CYAN}shogun init${RESET}"
  echo -e "  ${CYAN}shogun start${RESET}"
  echo -e "  ${CYAN}shogun task \"最初のタスクを説明\"${RESET}"
}

# ════════════════════════════════════════════════════════════
# メインディスパッチャ
# ════════════════════════════════════════════════════════════
# source されている場合はディスパッチをスキップ（テストから関数を直接呼び出せるようにする）
[[ "${BASH_SOURCE[0]}" != "${0}" ]] && return 0

COMMAND="${1:-help}"
shift 2>/dev/null || true

case "$COMMAND" in
  init)    cmd_init "$@" ;;
  task)    cmd_task "$@" ;;
  start)   cmd_start "$@" ;;
  stop)    cmd_stop "$@" ;;
  status)  cmd_status "$@" ;;
  logs)    cmd_logs "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *)
    error "不明なコマンド: ${COMMAND}"
    echo ""
    cmd_help
    exit 1
    ;;
esac
