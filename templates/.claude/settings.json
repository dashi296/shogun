{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SHOGUN_BIN_DIR\" ] && [ -f \"$SHOGUN_BIN_DIR/scripts/inject_role.sh\" ] && bash \"$SHOGUN_BIN_DIR/scripts/inject_role.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SHOGUN_BIN_DIR\" ] && [ -f \"$SHOGUN_BIN_DIR/scripts/stop_hook.sh\" ] && bash \"$SHOGUN_BIN_DIR/scripts/stop_hook.sh\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SHOGUN_BIN_DIR\" ] && [ -f \"$SHOGUN_BIN_DIR/scripts/mark_busy.sh\" ] && bash \"$SHOGUN_BIN_DIR/scripts/mark_busy.sh\" || true"
          }
        ]
      }
    ]
  }
}
